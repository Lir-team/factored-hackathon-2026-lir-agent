# Local secrets. .env.example is committed; .env never is.
.env
.env.*
!.env.example

# ADK dev UI local sessions (may contain user messages)
.adk/

# Local audit log (contains conversation metadata)
.audit/

# Local case inbox (CASES_INBOX=local; contains customer case payloads)
.cases/
