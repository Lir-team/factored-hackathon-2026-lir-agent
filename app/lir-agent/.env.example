# Committed template for local configuration.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Every variable read by the application must appear here, so the required
# configuration surface is reviewable in git without exposing any secret.
# Run commands from app/lir-agent/: `.env` is read from the working directory.

# Runtime environment: local | staging | production
ENVIRONMENT=local

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
# DEBUG also shows tool calls, query timings and LiteLLM/httpx output.
LOG_LEVEL=INFO

# LiteLLM model string: "<provider>/<model>".
#
# Local Ollama (pull first: `ollama pull llama3.1`):
LLM_MODEL=ollama_chat/llama3.1
LLM_API_BASE=http://localhost:11434
#
# OpenAI: comment the two lines above and use these instead.
# LLM_API_BASE must be present and empty, or the Ollama default is used.
# LLM_MODEL=openai/gpt-4o
# LLM_API_BASE=
# LLM_API_KEY=sk-...

# Data: `auto` uses DuckDB over $DATA_DIR/staging when the pipeline produced it,
# otherwise the team-generated demo fixture. `fixture` forces the demo data.
STORE=auto
# Optional: defaults to the repository's data/ folder.
# DATA_DIR=/absolute/path/to/data

# Minutes a signed-in session stays valid.
SESSION_TTL_MINUTES=15

# Date the agent treats as today (YYYY-MM-DD). Empty uses the current date.
# Set it to replay a static data snapshot, e.g. 2026-06-17 for LATAM Bank v1.0.0.
# REFERENCE_DATE=

# Local `adk web` only: seeds a clearly labeled test session for this customer.
# CLI-DEMO-001 exists in the demo fixture. Never set it in staging or production.
# DEV_CUSTOMER_ID=CLI-DEMO-001

# Typed decisions: default (Jev if JEV_ENABLED=1, else keyword baseline) | llm (LLM with
# structured output, falling back to the keyword baseline). DECISION_LLM_MODEL defaults to LLM_MODEL.
# DECISIONS=default
# DECISION_LLM_MODEL=
# Key for DECISION_LLM_MODEL on another provider; empty uses its own variable
# (e.g. OPENROUTER_API_KEY). LLM_API_KEY is only reused for LLM_MODEL itself.
# DECISION_LLM_API_KEY=
# DECISION_LLM_REASONING_EFFORT=none

# Jev (TypeSafe) through Cloudflare Workers AI, read by the decision layer.
# Without it the ES/PT keyword baseline decides.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# JEV_ENABLED=0

# HTTP API (`uv run lir-agent-api`). On Cloud Run, PORT is injected and IAP sets the
# identity header; requests without it are rejected. Set REQUIRE_IDENTITY=false only for
# local runs without IAP.
# PORT=8080
# REQUIRE_IDENTITY=true
# IDENTITY_HEADER=X-Goog-Authenticated-User-Email
# MAX_MESSAGE_CHARS=2000
# Browser origins allowed to call the API (comma-separated). Only for local runs with
# lir-web on another port; on Cloud Run API Gateway handles CORS.
# CORS_ORIGINS=http://localhost:5500

# Case intake (`POST /v1/cases`). API Gateway verifies the customer JWT and forwards its
# claims as base64url JSON in CUSTOMER_IDENTITY_HEADER; CUSTOMER_CLAIM holds the customer id.
# With REQUIRE_IDENTITY=false and no header, the payload's customer_id is trusted (local only).
# CUSTOMER_IDENTITY_HEADER=X-Apigateway-Api-Userinfo
# CUSTOMER_CLAIM=sub
# Accepted cases are archived: local (files under CASES_LOCAL_DIR) | gcs (CASES_BUCKET).
# Use gcs on Cloud Run.
# CASES_INBOX=local
# CASES_BUCKET=cases-inbox
# Optional: defaults to app/lir-agent/.cases (git-ignored).
# CASES_LOCAL_DIR=/absolute/path/to/cases
# Telegram bot username (without "@") for the start link in the 202 answer; empty: no link.
# TELEGRAM_BOT_USERNAME=
# Minutes a Telegram start link stays usable.
# START_TOKEN_TTL_MINUTES=1440
# How accepted cases reach the agent: none (kept in memory, never worked) | pubsub
# (published to CASES_TOPIC in GOOGLE_CLOUD_PROJECT, ordered per customer). Set
# PUBSUB_EMULATOR_HOST=localhost:8085 to publish to the local emulator instead.
# CASES_PUBLISHER=none
# GOOGLE_CLOUD_PROJECT=
# CASES_TOPIC=lir-cases
# PUBSUB_EMULATOR_HOST=localhost:8085

# Case processing (`POST /pubsub/push`), called by the push subscription of CASES_TOPIC.
# Each call carries a Google OIDC token for PUBSUB_PUSH_AUDIENCE, signed as
# PUBSUB_PUSH_SERVICE_ACCOUNT when set. Without an audience the route is absent.
# PUBSUB_VERIFY_TOKEN=false accepts unsigned calls: local emulator only.
# PUBSUB_PUSH_AUDIENCE=
# PUBSUB_PUSH_SERVICE_ACCOUNT=
# PUBSUB_VERIFY_TOKEN=true

# Telegram channel (`POST /channels/telegram`): the bot token from BotFather and the
# secret_token registered with setWebhook (see README). Without both, the route is absent.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# Minutes a case's conversation stays valid (7 days), counted from its delivery.
# CASE_SESSION_TTL_MINUTES=10080

# Case store (receipts, start tokens, chat links, case conversations, waiting replies):
# memory (lost on restart, one instance only) | firestore (in GOOGLE_CLOUD_PROJECT). Set
# FIRESTORE_EMULATOR_HOST=localhost:8086 to use the local emulator instead.
# CASE_STORE=memory
# FIRESTORE_DATABASE=(default)
# FIRESTORE_COLLECTION_PREFIX=lir_
# FIRESTORE_EMULATOR_HOST=localhost:8086

# Audit log: jsonl (local file at AUDIT_PATH) | stdout (structured JSON for Cloud Logging).
# AUDIT_SINK=jsonl
