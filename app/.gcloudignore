# Files `gcloud builds submit app` does not upload. gcloud ignores nested .gitignore files,
# so local virtualenvs, caches and secrets are listed here explicitly.
.gcloudignore
**/.venv/
**/__pycache__/
**/*.py[oc]
**/.pytest_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.audit/
**/.adk/
**/out/
**/node_modules/
**/.env
**/.env.*
!**/.env.example
