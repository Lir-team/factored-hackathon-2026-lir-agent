# Committed template for local configuration.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Every variable read by the application must appear here, so the required
# configuration surface is reviewable in git without exposing any secret.

ENVIRONMENT=local
LOG_LEVEL=INFO

# LiteLLM model string: "<provider>/<model>". The provider decides which
# credentials LiteLLM reads from the environment.
#
# Local Ollama (model must be pulled first: `ollama pull llama3.1`):
LLM_MODEL=ollama_chat/llama3.1
LLM_API_BASE=http://localhost:11434
#
# OpenAI: comment the two lines above and use these instead.
# LLM_MODEL=openai/gpt-4o-mini
# LLM_API_BASE=
# OPENAI_API_KEY=sk-...
