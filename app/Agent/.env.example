# Committed template for local configuration.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Every variable read by the application must appear here, so the required
# configuration surface is reviewable in git without exposing any secret.

ENVIRONMENT=local
LOG_LEVEL=INFO

# LiteLLM model string: "<provider>/<model>". Use the "ollama_chat/" provider
# for Ollama; the model must already be pulled (`ollama pull llama3.1`).
LLM_MODEL=ollama_chat/llama3.1
# Where the Ollama server listens.
LLM_API_BASE=http://localhost:11434
