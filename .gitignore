# Monorepo-wide rules. Each area (data/, ...) has its own .gitignore.

# Organizer documents (the data dictionary contains S3 credentials)
*.pdf

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/

# Claude Code: local overrides stay out of the repo
.claude/settings.local.json
